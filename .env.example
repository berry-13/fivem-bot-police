# Token del bot: Discord Developer Portal -> la tua app -> Bot -> Reset Token.
# Non committare mai il file .env con il token reale.
DISCORD_TOKEN=

# Application ID della tua app, serve solo per "npm run deploy".
CLIENT_ID=

# Opzionale. Se valorizzato, gli slash command vengono registrati solo in questo
# server ed sono disponibili subito: comodo in sviluppo.
# Se lasciato vuoto la registrazione e' globale (fino a un'ora di propagazione).
GUILD_ID=

# Opzionale. Prefisso dei comandi testuali, default "!".
COMMAND_PREFIX=!
