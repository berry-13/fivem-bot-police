# Token del bot: Discord Developer Portal -> la tua app -> Bot -> Reset Token.
# Non committare mai il file .env con il token reale.
DISCORD_TOKEN=

# Application ID della tua app, serve solo per "npm run deploy".
CLIENT_ID=

# Opzionale. Se valorizzato, gli slash command vengono registrati solo in questo
# server ed sono disponibili subito: comodo in sviluppo.
# Se lasciato vuoto la registrazione e' globale (fino a un'ora di propagazione).
GUILD_ID=

# Opzionale. Prefisso dei comandi testuali, default "!".
COMMAND_PREFIX=!

# --- Notifiche live (Twitch / TikTok) ----------------------------------------
# Id del canale Discord dove mandare "X e' in live".
# Clic destro sul canale -> Copia ID canale (serve la Modalita' sviluppatore).
LIVE_CHANNEL_ID=

# Opzionale. Chi pingare in ogni notifica live:
# - vuoto: nessun ping
# - id di un ruolo: ping di quel ruolo
# - "everyone" (oppure l'id del server): ping @everyone
#   Serve il permesso "Menziona @everyone, @here e tutti i ruoli" sul bot.
LIVE_ROLE_ID=

# Credenziali app Twitch (https://dev.twitch.tv/console). Serve solo per gli
# streamer platform: twitch in src/config/live.js. TikTok non le usa.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Opzionale. Intervallo di controllo in millisecondi (default 60000, minimo 15000).
# LIVE_POLL_INTERVAL_MS=60000
